# ─────────────────────────────────────────────────────────────────────────────
# Nobitex trading bot — credential template
# Copy this file to .env and fill in your values.
# .env is git-ignored; NEVER commit your real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── OPTION A: API Key (recommended for production bots) ──────────────────────
#
# Create at: Nobitex panel → Profile → API Keys → New Key
#   • Set permissions to READ,TRADE  (do NOT add WITHDRAW)
#   • Add your server's IP to the whitelist
#   • Set an expiration date (e.g. 90 days)
#   • The privateKey is shown ONCE — save it immediately
#
NOBITEX_API_PUBLIC_KEY=
NOBITEX_API_PRIVATE_KEY=

# ── OPTION B: Session token (simpler, max 30-day lifespan) ───────────────────
#
# Get at: Nobitex panel → Profile → Settings → API Token
# If you used "Remember me" when logging in the token lives up to 30 days.
#
# NOBITEX_TOKEN=your_token_here

# ── Testnet (optional) ───────────────────────────────────────────────────────
# Set to "true" to point at https://testnet.nobitex.ir instead of production.
# NOBITEX_TESTNET=false

# Nobitex bypasses HTTP_PROXY / HTTPS_PROXY / ALL_PROXY and legacy
# NOBITEX_HTTPS_PROXY. Other exchanges retain environment proxy settings.
# Exclude Nobitex domains in the VPN's split-tunneling rules for VPN bypass.

# Dashboard: run python main.py setup-password to populate the hash.
# No default password exists. Leave exchange credentials empty for research.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DASHBOARD_SECURE_COOKIE=false
DASHBOARD_SESSION_SECONDS=43200
TRADER_HOST=127.0.0.1
TRADER_PORT=8011

# Optional absolute paths. Set TRADER_ENV_FILE in the shell/service environment
# before launch to select an alternate file. Defaults are source/.runtime and
# source/.env, independently of the working directory.
# TRADER_DATA_DIR=D:/TradingData
# TRADER_ENV_FILE=D:/TradingSecrets/operator.env

# Private HTTPS server: set its exact hostname (no scheme/port), preserve Host
# at the proxy, enable Secure cookies, and keep the application on loopback.
# DASHBOARD_ALLOWED_HOSTS=trading.example.internal
# DASHBOARD_SECURE_COOKIE=true
