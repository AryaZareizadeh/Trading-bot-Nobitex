# Copy to docker.env, fill every required value, and keep that file private.
# Generate TRADER_MASTER_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRADER_MASTER_KEY=
TRADER_INVITE_CODE=
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
DASHBOARD_SECURE_COOKIE=false
DASHBOARD_SESSION_SECONDS=43200

# Nobitex always connects directly; legacy NOBITEX_HTTPS_PROXY is ignored.
# HTTP_PROXY / HTTPS_PROXY / ALL_PROXY still apply to other exchanges.
# VPN tunnel routing must exclude Nobitex in the VPN's split-tunneling rules.
# For Docker Desktop using the Windows system proxy (for example v2rayN),
# enable these after verifying the public checks in docs/nobitex-connectivity.md:
# HTTP_PROXY=http://gateway.docker.internal:3128
# HTTPS_PROXY=http://gateway.docker.internal:3128
# NO_PROXY=localhost,127.0.0.1,::1,nobitex.ir,.nobitex.ir,nobitx.com,.nobitx.com

# Optional: limit workers per optimizer job. By default the selector offers every
# logical CPU visible to the container (for example, 1 through 16 on a 16-thread CPU).
# OPTIMIZER_MAX_CORES_PER_JOB=8

# Email is required for signup confirmation and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
